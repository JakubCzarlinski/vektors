diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 5909212..213db4c 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -107,6 +107,17 @@ if (NOT APPLE_STATIC_LOADER)
 endif()
 target_include_directories(test_fuzzing PUBLIC ${CMAKE_SOURCE_DIR}/loader ${CMAKE_SOURCE_DIR}/loader/generated)
 
+# Public-loader fuzz cases resolve Vulkan entry points through
+# VK_LOADER_TEST_LOADER_PATH. Keep them in a loader-neutral executable so a
+# comparison run does not also map the upstream loader into the process.
+add_executable(
+    test_fuzzing_loader_neutral
+        loader_testing_main.cpp
+        loader_fuzz_tests.cpp
+)
+target_link_libraries(test_fuzzing_loader_neutral PUBLIC testing_dependencies)
+target_compile_definitions(test_fuzzing_loader_neutral PUBLIC VK_NO_PROTOTYPES LOADER_TEST_LOADER_NEUTRAL)
+
 # Threading tests live in separate executabe just for threading tests as it'll need support
 # in the test harness to enable in CI, as thread sanitizer doesn't work with address sanitizer enabled.
 add_executable(
@@ -141,10 +152,12 @@ endif()
 if(NOT CMAKE_CROSSCOMPILING)
     gtest_discover_tests(test_regression PROPERTIES DISCOVERY_TIMEOUT 100)
     gtest_discover_tests(test_fuzzing PROPERTIES DISCOVERY_TIMEOUT 100)
+    gtest_discover_tests(test_fuzzing_loader_neutral PROPERTIES DISCOVERY_TIMEOUT 100)
     gtest_discover_tests(test_threading PROPERTIES DISCOVERY_TIMEOUT 100)
 else()
     gtest_add_tests(TARGET test_regression)
     gtest_add_tests(TARGET test_fuzzing)
+    gtest_add_tests(TARGET test_fuzzing_loader_neutral)
     gtest_add_tests(TARGET test_threading)
 endif()
 
